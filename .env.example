# --- Telegram -------------------------------------------------------------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID группы/канала, куда публикуется дайджест (у групп он отрицательный).
# Добавьте бота в группу и выполните /chatid, чтобы узнать значение.
TELEGRAM_CHAT_ID=-1001234567890
# ID пользователей, которым разрешена команда /digest (через запятую).
# Если пусто — команда принимается только из чата TELEGRAM_CHAT_ID.
ADMIN_USER_IDS=

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=4000

# --- Расписание -----------------------------------------------------------
# Время ежедневной публикации в формате ЧЧ:ММ и часовой пояс (IANA)
DIGEST_TIME=08:00
TIMEZONE=Europe/Moscow

# --- Отбор новостей -------------------------------------------------------
# Сколько новостей в выпуске: если основных лент не хватает на MIN_ITEMS,
# подключается фолбэк через поиск.
MIN_ITEMS=5
MAX_ITEMS=8
# Новости старше этого возраста (в часах) не берём
MAX_AGE_HOURS=36

# --- Хранилище и логи -----------------------------------------------------
DB_PATH=digest.db
# Сколько дней хранить историю публикаций для дедупликации
KEEP_HISTORY_DAYS=120
LOG_FILE=bot.log
LOG_LEVEL=INFO

# --- Сеть -----------------------------------------------------------------
HTTP_TIMEOUT=15
USER_AGENT=Mozilla/5.0 (compatible; NewsDigestBot/1.0)
