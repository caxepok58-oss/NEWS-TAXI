# --- Telegram -------------------------------------------------------------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID группы/канала, куда публикуется дайджест (у групп он отрицательный).
# Добавьте бота в группу и выполните /chatid, чтобы узнать значение.
TELEGRAM_CHAT_ID=-1001234567890
# ID пользователей через запятую: им разрешена команда /digest и им же
# приходят сообщения о сбоях. Если пусто — команда принимается только
# из чата TELEGRAM_CHAT_ID, а о сбоях никто не узнает (только лог).
ADMIN_USER_IDS=

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=4000

# --- Расписание -----------------------------------------------------------
# Время ежедневной публикации в формате ЧЧ:ММ и часовой пояс (IANA)
DIGEST_TIME=08:00
TIMEZONE=Europe/Moscow
# Повтор после неудачного планового прогона: через сколько минут и сколько раз.
# RETRY_MINUTES=0 отключает повторы.
RETRY_MINUTES=30
MAX_RETRY_ATTEMPTS=2

# --- Отбор новостей -------------------------------------------------------
# Сколько новостей в выпуске. Если основных лент не хватает на MIN_ITEMS
# или какая-то тема осталась пустой, подключается фолбэк через поиск.
MIN_ITEMS=5
MAX_ITEMS=8
# Сколько кандидатов уходит модели на финальный отбор
CANDIDATE_LIMIT=20
# Не больше стольких заметок от одного издания в выпуске (0 — без ограничения)
MAX_PER_SOURCE=2
# Новости старше этого возраста (в часах) не берём
MAX_AGE_HOURS=36
# За сколько дней сверять сюжеты, чтобы не писать дважды об одном событии
# разными словами (0 — только точная проверка по ссылке и заголовку)
STORY_DEDUP_DAYS=3

# --- Контроль лент --------------------------------------------------------
# После скольких прогонов подряд без единой записи предупреждать админов.
# Разовая проверка всех адресов: python main.py --check-feeds
FEED_ALERT_AFTER=3

# --- Срочные новости ------------------------------------------------------
# Отдельный короткий пост, если в Пензе случилось что-то серьёзное и ждать
# утреннего выпуска нельзя. BREAKING_ENABLED=0 — отключить.
BREAKING_ENABLED=1
# Как часто проверять ленты между выпусками (в часах)
BREAKING_EVERY_HOURS=2
# Новость считается срочной, только если она свежее этого срока
BREAKING_MAX_AGE_HOURS=4
# Не больше стольких срочных постов в сутки
BREAKING_MAX_PER_DAY=2
# Окно, в котором разрешено публиковать вне расписания (часы по TIMEZONE)
BREAKING_FROM_HOUR=9
BREAKING_TO_HOUR=21

# --- Текст статей ---------------------------------------------------------
# Дочитывать страницу издания, чтобы пересказ не строился на одной строке
# описания из RSS. 0 — отключить (быстрее, но пересказы беднее).
FETCH_FULL_TEXT=1
# Сколько символов текста статьи отдавать модели
ARTICLE_TEXT_LEN=1500

# --- Оформление поста -----------------------------------------------------
# buttons — ссылки уходят в кнопки под постом, текст остаётся чистым
# inline  — ссылка строкой под каждой новостью
LINKS_MODE=buttons
# Закреплять утренний дайджест в чате (боту нужны права администратора)
PIN_DIGEST=1

# --- Картинка к посту -----------------------------------------------------
# cover  — обложка выпуска рисуется локально (по умолчанию, ключей не нужно)
# ai     — иллюстрацию генерирует Kandinsky, нужны ключи ниже
# source — фотография из вложения RSS у главной новости
# off    — публиковать без картинки
IMAGE_MODE=cover
# Бесплатные ключи для режима ai: https://fusionbrain.ai/keys
FUSIONBRAIN_API_KEY=
FUSIONBRAIN_SECRET_KEY=
# Куда сохранять картинку при запуске с --dry-run
DRY_RUN_IMAGE=digest-preview.png

# --- Хранилище и логи -----------------------------------------------------
DB_PATH=digest.db
# Сколько дней хранить историю публикаций для дедупликации
KEEP_HISTORY_DAYS=120
LOG_FILE=bot.log
LOG_LEVEL=INFO

# --- Сеть -----------------------------------------------------------------
HTTP_TIMEOUT=15
USER_AGENT=Mozilla/5.0 (compatible; NewsDigestBot/1.0)
